<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@color/background"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:visibility="visible"
        android:id="@+id/line"
        android:layout_height="1dp"
        android:background="@android:color/black" />

        <TextView
            android:id="@+id/item_list_data"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#D5A10F"
            android:textStyle="bold"
            android:textSize="17sp"
            android:paddingHorizontal="2sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Дата" />

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:orientation="horizontal"
    >

        <TextView
            android:id="@+id/item_list_time"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#D5A10F"
            android:textSize="17sp"
            android:text="10:00" />



    <TextView
        android:id="@+id/item_list_title_name"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Название"
        android:textSize="17sp"
         />

    <TextView
        android:id="@+id/item_list_text_count_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:textSize="17sp"
        android:text="Кол-во:8  1250 руб." />

</LinearLayout>


</LinearLayout>