<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D5D5D5">

<Button
    android:layout_width="70dp"
    android:layout_height="40dp"
    android:layout_marginLeft="330dp"
    android:backgroundTint="@color/black"
    android:text="Выйти"
    android:textSize="17dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_marginTop="0dp"
        android:background="#4285B4">
    </RelativeLayout>

    <Button
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginLeft="330dp"
        android:backgroundTint="@color/black"
        android:text="Выйти"
        android:textSize="10dp" />

    <RelativeLayout
        android:layout_width="380dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        android:gravity="center_horizontal"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/round"
        android:backgroundTint="#FFFFFF"
        >
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/button_data_sort1"
                    android:layout_width="140dp"
                    android:layout_height="18dp"
                    android:gravity="center_horizontal"
                    android:text="C 30 Июня"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/button_data_sort2"
                    android:layout_width="150dp"
                    android:layout_height="18dp"
                    android:gravity="center_horizontal"
                    android:text="До 15 Июля"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    />
            </LinearLayout>

            <TextView
                android:id="@+id/main_sum"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:text="10000 руб."
                android:textSize="27dp"
                android:textColor="@color/black"
                android:fontFamily="@font/inter_bold"
                />
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:text="Неделя"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="75dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:text="2 Недели"
                    android:textSize="16dp"
                    android:layout_marginHorizontal="50dp"
                    android:textColor="#4285b4"
                    />
                <TextView
                    android:layout_width="75dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:text="Месяц"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    />
            </LinearLayout>



        </LinearLayout>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_list"
        android:layout_marginTop="175dp"
        android:layout_marginHorizontal="20dp"
        android:layout_width="match_parent"
        android:layout_height="520dp" />

    <Button
        android:id="@+id/button_toAdd"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:gravity="center"
        android:layout_marginTop="670dp"
        android:layout_marginLeft="340dp"
        android:backgroundTint="#4285B4"
        android:onClick="toAddAct"
        android:paddingHorizontal="20dp"
        android:text="+" />
</RelativeLayout>