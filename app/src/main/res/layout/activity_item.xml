<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="#e2a600"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ItemActivity">



    <EditText
        android:id="@+id/item_list_title_name_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textStyle="bold"
        android:textSize="30sp"
        android:text="TextView" />
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Button
        android:id="@+id/button_data_a"
        android:layout_width="185dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D5A10F"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"
        style="?android:spinnerStyle"

        android:text="Дата" />

    <Button
        android:id="@+id/button_time_a"
        android:layout_width="185dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D5A10F"
        android:textStyle="bold"
        style="?android:spinnerStyle"
        android:paddingHorizontal="20dp"
        android:text="Время" />

</LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textStyle="bold"
        android:textSize="17sp"
        android:text="Кол-во" />

        <EditText
            android:id="@+id/item_list_text_count_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textStyle="bold"
            android:inputType="number"
            android:textSize="17sp"
            android:text="8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:text="Итого:" />

        <EditText
            android:id="@+id/item_list_text_price_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:inputType="number"
            android:paddingVertical="10dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:text="8" />


    </LinearLayout>

    <TextView
        android:id="@+id/item_list_desc_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textSize="15sp"
        android:text="Описание" />


    <ImageButton
        android:id="@+id/photo_item"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp"
        android:backgroundTint="@android:color/transparent"
        android:onClick="openGallery"
        android:scaleType="centerInside"
        app:srcCompat="@color/cardview_shadow_end_color"
        tools:srcCompat="@drawable/palm" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <Button
        android:id="@+id/button_red_a"
        android:layout_width="200dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:backgroundTint="#D5A10F"
        android:text="Редактировать" />

        <Button
            android:id="@+id/button_delete_a"
            android:layout_width="200dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:backgroundTint="#D5A10F"
            android:text="Удалить" />

    </LinearLayout>

</LinearLayout>